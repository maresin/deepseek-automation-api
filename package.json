{
  "name": "deepseek-automation-api",
  "version": "1.0.0",
  "description": "Portable DeepSeek automation API with OpenAI compatibility and RAG support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist browsers uploads state.json .api-key rag_data",
    "postinstall": "node scripts/install-browser.js",
    "prepublishOnly": "npm run build",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node examples/basic.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "compute-cosine-similarity": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "multer": "^1.4.5-lts.1",
    "playwright-core": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "deepseek",
    "automation",
    "api",
    "openai",
    "playwright",
    "rag"
  ],
  "license": "MIT"
}