# ============================================================
# Agent A — environment
# ============================================================
#
# Copy to .env.a:
#
#     cp env.a.example .env.a
#
# Every path here is relative to THIS directory when start-all.sh
# runs. If you launch agents manually from the project root, adjust
# them accordingly.

PORT=3000

# ---- DeepSeek account ----------------------------------------
# Leave EMAIL and PASSWORD empty. The login path is not used when
# DEEPSEEK_STATE_PATH points to a valid cookie session, and having
# credentials here would only tempt the client into the captcha
# path if the cookies ever go stale.
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=

DEEPSEEK_HEADLESS=true

# ---- Shared browser state ------------------------------------
# ONE file, used by BOTH agents. This is the entire point of the
# multi-agent setup: a single DeepSeek cookie session, established
# once, reused everywhere.
DEEPSEEK_STATE_PATH=./shared-state.json

# ---- Isolated per-agent state --------------------------------
# These MUST be unique per agent. If two agents share any of these,
# they will overwrite each other's state and end up in the same chat.
DEEPSEEK_CHAT_STATE_PATH=./chat_state-a.json
DEEPSEEK_API_KEY_PATH=./.api-key-a
DEEPSEEK_UPLOAD_DIR=./uploads-a
RAG_DATA_DIR=./rag_data-a

# ---- Recovery modes ------------------------------------------
ENABLE_RESTORE=true
ENABLE_SNAPSHOT=true
ENABLE_RAG=true
