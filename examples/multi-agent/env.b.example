# ============================================================
# Agent B — environment
# ============================================================
#
# Copy to .env.b:
#
#     cp env.b.example .env.b
#
# Same shape as env.a.example, with the "b" suffix on every path
# that must be unique and a different port. Only DEEPSEEK_STATE_PATH
# stays the same.

PORT=3001

DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=

DEEPSEEK_HEADLESS=true

# Same shared file as agent A.
DEEPSEEK_STATE_PATH=./shared-state.json

# Unique paths.
DEEPSEEK_CHAT_STATE_PATH=./chat_state-b.json
DEEPSEEK_API_KEY_PATH=./.api-key-b
DEEPSEEK_UPLOAD_DIR=./uploads-b
RAG_DATA_DIR=./rag_data-b

ENABLE_RESTORE=true
ENABLE_SNAPSHOT=true
ENABLE_RAG=true