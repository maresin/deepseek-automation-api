# =================================================================
# DeepSeek Automation API — configuration template
# =================================================================
#
# Copy this file to .env and fill in the values you need.
#
#     cp .env.example .env
#
# Only DEEPSEEK_EMAIL and DEEPSEEK_PASSWORD (or an existing
# state.json from a prior login) are strictly required for the
# server to run. Everything else has a sensible default.

# -----------------------------------------------------------------
# Core
# -----------------------------------------------------------------
PORT=3000

# DeepSeek account credentials for automatic first-time login.
# Leave empty if you prefer to log in manually via a browser window
# (DEEPSEEK_HEADLESS=false) or if you already have a state.json
# (stateless mode) or a Chrome profile (CDP mode).
#
# In CDP mode, these are not used — the Chrome profile is the
# authenticated session.
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=

# Stateless-mode only: run bundled Chromium without a visible window.
# In CDP mode this is ignored (the user's Chrome is always visible).
DEEPSEEK_HEADLESS=false

# Tool-call response format inside the chat with DeepSeek.
#
#   auto — ask the model for JSON (via prompts/tools_prompt.txt);
#          accept both JSON and DSML as valid responses.
#          Default. Safest: the prompt asks for JSON but if the
#          model slips into DSML (its native format), the parser
#          still extracts the tool call.
#
#   json — strict JSON. Any DSML in the response becomes a parse
#          error. Use when you want to force JSON and treat DSML
#          as a bug.
#
#   dsml — ask the model for DSML (via prompts/tools_prompt_dsml.txt).
#          Experimental: DSML is DeepSeek's internal format, not
#          documented. Some model revisions comply, some ignore the
#          instruction. The parser accepts JSON as a fallback.
#
# The API always returns standard OpenAI JSON to the client; this
# setting only affects the format requested from the model inside
# the chat.
DEEPSEEK_TOOL_FORMAT=dsml

# -----------------------------------------------------------------
# Browser mode
# -----------------------------------------------------------------
#
# Two mutually exclusive modes:
#
#   1. CDP mode (recommended). Set DEEPSEEK_CDP_URL. The API connects
#      to a Chrome running with --remote-debugging-port. Cloudflare
#      sees a normal user-launched Chrome — the only approach that
#      reliably passes Turnstile on the DeepSeek login page.
#
#   2. Stateless mode (default). Leave DEEPSEEK_CDP_URL empty. The
#      API launches its own bundled Chromium (or system Chrome) and
#      restores cookies from state.json. Works when Cloudflare is
#      not blocking.
#
# Autolaunch behavior in CDP mode:
#   - If Chrome is already running on the CDP port (started by the
#     user, or by a host extension like Pingis), the API uses it and
#     does NOT touch its lifecycle. It will never be closed by the API.
#   - If nothing is running and DEEPSEEK_CDP_AUTOLAUNCH=true (default),
#     the API launches Chrome with the profile below.
#   - On shutdown, the API closes Chrome only if it launched it itself
#     AND DEEPSEEK_CDP_AUTOCLOSE=true.

# --- CDP mode ---
#
# Before enabling CDP mode, prepare Chrome:
#   1. Sign in to Chrome with your Google account (top-right →
#      "Sign in" / "Turn on sync"). A fresh profile without a
#      Google session is more likely to trigger Cloudflare.
#   2. Set English as the preferred UI language:
#      Settings → Languages → Preferred languages → add English,
#      drag it to the top. Playwright selectors are English-only.
#   3. Log in to chat.deepseek.com once in that same Chrome.
#      The cookies and cf_clearance live in the profile and are
#      reused by the API on every start.
#
# Without these steps the API starts but DeepSeek shows the
# verify-account modal, and text selectors fail on non-English UI.
#
# Set to trigger CDP mode. Typical: http://127.0.0.1:9222
DEEPSEEK_CDP_URL=

# Port used when autolaunching. Also the default port for the URL
# if DEEPSEEK_CDP_URL is not set but DEEPSEEK_CDP_AUTOLAUNCH=true.
DEEPSEEK_CDP_PORT=9222

# Profile directory for autolaunched Chrome. On first launch, if
# the directory is empty and DEEPSEEK_CDP_COPY_DEFAULT_PROFILE is
# true, the user's ~/.config/google-chrome is copied here. That
# copy carries cookies, history, and fingerprint — the actual
# bypass for Cloudflare.
DEEPSEEK_CDP_PROFILE_DIR=~/.config/google-chrome-cdp

# Chromium-based browser to autolaunch. Must support
# --remote-debugging-port. Examples:
#   google-chrome-stable, chromium, chromium-browser, microsoft-edge
DEEPSEEK_CHROME_PATH=google-chrome-stable

# Launch Chrome if nothing is listening on the CDP port.
# Set to false when a host extension manages Chrome itself.
DEEPSEEK_CDP_AUTOLAUNCH=true

# Close the autolaunched Chrome when the API shuts down.
# Default true: clean shutdown, no orphan processes, good for
# host extensions (e.g. Pingis) that start/stop the API per task.
#
# Set to false for fast restarts: Chrome stays alive between
# Ctrl+C cycles, and the next start reuses the tab by chat id
# (tab reuse — 3s instead of 8-10s). Tab reuse still works with
# AUTOCLOSE=true, but only after an unclean shutdown (kill -9).
DEEPSEEK_CDP_AUTOCLOSE=true

# Copy the user's default Chrome profile when the target profile
# directory is empty (first launch only). On subsequent launches
# nothing is copied — the CDP profile is self-contained and Chrome
# refreshes its own cookies there.
#
# WARNING: this copy inherits Google and DeepSeek sessions from
# ~/.config/google-chrome. If those are stale, Cloudflare will
# trigger a verification challenge on first contact. Set to false
# for a clean profile and log in manually once (safer).
DEEPSEEK_CDP_COPY_DEFAULT_PROFILE=true

# Extra flags appended to the Chrome command line, space-separated.
# Example: --start-maximized --disable-gpu
DEEPSEEK_CHROME_EXTRA_ARGS=

# --- Stateless mode ---

# Browser to launch when DEEPSEEK_CDP_URL is empty:
#   chromium — bundled Chromium under ./browsers (default)
#   chrome   — system Google Chrome, discovered by Playwright
DEEPSEEK_BROWSER=chromium

# -----------------------------------------------------------------
# Recovery modes
# -----------------------------------------------------------------

# Reopen the last chat on startup.
ENABLE_RESTORE=true

# Snapshot cycle at 70% / 90% of context.
ENABLE_SNAPSHOT=false

# Index history and search it after each transition.
ENABLE_RAG=false

# -----------------------------------------------------------------
# Paths
# -----------------------------------------------------------------

# Browser cookies and origins (Playwright storageState).
# Used only in stateless mode. In CDP mode the Chrome profile
# is the source of truth and this file is not written or read.
DEEPSEEK_STATE_PATH=./state.json

# Chat session state (lastChatId, totalChars, snapshot flags).
# Per-process: must be unique when running multiple agents.
DEEPSEEK_CHAT_STATE_PATH=./chat_state.json

# API key for clients (Bearer token). Per-process.
DEEPSEEK_API_KEY_PATH=./.api-key

# Temporary uploads, snapshot.txt, rag_context_*.txt.
# Per-process.
DEEPSEEK_UPLOAD_DIR=./uploads

# -----------------------------------------------------------------
# Context and RAG tuning
# -----------------------------------------------------------------

# Fallback context limit before language analysis (characters).
DEEPSEEK_MAX_CONTEXT_CHARS=2400000

# Context multiplier when DeepThink is on.
DEEPSEEK_DEEPTHINK_MULTIPLIER=2.5

# Chunk size for RAG embedding (characters).
RAG_CHUNK_SIZE=2000

# Minimum recency multiplier in RAG ranking (0.0–1.0).
RAG_RECENCY_FLOOR=0.7

# Directory for per-session RAG indexes. Per-process.
RAG_DATA_DIR=./rag_data

# -----------------------------------------------------------------
# Server Busy handling
# -----------------------------------------------------------------
#
# When DeepSeek returns the "server busy" placeholder, the API
# retries internally before giving up. DeepSeek needs several
# minutes of cooldown between attempts.
#
# IMPORTANT: with the defaults, a single POST /v1/chat/completions
# may take up to (MAX_RETRIES + 1) × DELAY_MS ≈ 20 minutes when
# DeepSeek is busy. Clients must set their timeouts accordingly,
# or set DEEPSEEK_BUSY_MAX_RETRIES=0 for an immediate 503 with a
# Retry-After header.

# Retries after the initial attempt. 0 disables retry entirely.
DEEPSEEK_BUSY_MAX_RETRIES=3

# Delay between retries, in milliseconds. 300000 = 5 minutes.
DEEPSEEK_BUSY_DELAY_MS=300000

# Old behaviour: process.exit(1) after responding with 503.
# Default false keeps the agent alive.
DEEPSEEK_SHUTDOWN_ON_SERVER_BUSY=false

# -----------------------------------------------------------------
# Multi-agent deployments
# -----------------------------------------------------------------
#
# Generated by tools/make-multi-agent.sh. Two modes:
#
#   Stateless (no flag): each agent launches its own browser and
#   restores cookies from shared-state.json. Works when Cloudflare
#   is not blocking.
#
#   CDP (--cdp-url URL): each agent connects to the Chrome at URL.
#   shared-state.json is not used; the Chrome profile carries the
#   session. Each agent opens its own tab. On stop, only the agent
#   closes its tab; Chrome survives for other agents and for tab
#   reuse on restart.
#
#   ./tools/make-multi-agent.sh ~/my-project --agents 2 \
#       --cdp-url http://127.0.0.1:9222
#
# For Pingis (VS Code extension): the extension starts Chrome itself
# and calls make-multi-agent.sh --cdp-url per task. Chrome survives
# API shutdowns; the extension is responsible for its lifecycle.